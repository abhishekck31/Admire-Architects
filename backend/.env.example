# Copy to backend/.env and fill in. Never commit the real file.

# --- Django ---------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com

# --- Storage --------------------------------------------------------------
# Where the database, uploaded photos and CVs live. Kept outside the code
# checkout so re-cloning the repo cannot destroy the client's content.
# Defaults to ~/admire-data, which is usually right.
# DATA_ROOT=/home/yourusername/admire-data

# The database. Defaults to SQLite inside DATA_ROOT, which is what the free
# PythonAnywhere tier supports. On a paid plan, install the driver and switch:
#   DATABASE_URL=mysql://user:password@yourusername.mysql.pythonanywhere-services.com:3306/yourusername$admire

# --- Talking to the Next.js site ------------------------------------------
# Shared secret the frontend sends as X-Api-Key on every request. Must match
# BACKEND_API_KEY in the Vercel project settings.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=replace-me

# Absolute base prepended to uploaded photo paths, so the API hands Next.js
# fully-qualified URLs. No trailing slash.
PUBLIC_MEDIA_BASE=https://yourusername.pythonanywhere.com

# Where the dashboard tells the live site to refresh after a save. Must match
# REVALIDATE_SECRET in the Vercel project settings.
NEXT_REVALIDATE_URL=https://admiregrp.in/api/revalidate
NEXT_REVALIDATE_SECRET=replace-me
