# Copy to .env.local for development. Vercel gets the same keys in its
# project settings. The backend's own values live in backend/.env.

# Django backend on PythonAnywhere. No trailing slash.
BACKEND_URL=https://yourusername.pythonanywhere.com

# Must match BACKEND_API_KEY in backend/.env. Sent as X-Api-Key on every
# request; only ever used server-side, so it never reaches a browser.
BACKEND_API_KEY=replace-me

# Must match NEXT_REVALIDATE_SECRET in backend/.env. Used to verify the
# "refresh the live site" ping the dashboard sends after a save.
REVALIDATE_SECRET=replace-me
